{
  "name": "exploretangsel",
  "version": "1.0.0",
  "private": true,
  "description": "ExploreTangsel: temukan hidden gem wisata, kuliner, dan akses di Tangerang Selatan",
  "scripts": {
    "build": "node scripts/copy-vendor.mjs",
    "android:add": "npx cap add android && node scripts/patch-android.mjs",
    "ios:add": "npx cap add ios && bash scripts/patch-ios.sh",
    "assets": "npx capacitor-assets generate --iconBackgroundColor \"#12443F\" --iconBackgroundColorDark \"#12443F\" --splashBackgroundColor \"#12443F\" --splashBackgroundColorDark \"#0C302C\"",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap run android",
    "ios": "npm run sync && npx cap run ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/app-launcher": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "hls.js": "^1.5.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
